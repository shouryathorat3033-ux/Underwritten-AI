{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "python",
          "format": "url",
          "env": "PYTHON_BACKEND_URL"
        }
      ]
    },
    "python": {
      "root": "python",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
