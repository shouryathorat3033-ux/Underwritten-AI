# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/underwriteai

# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_characters_long
NEXTAUTH_URL=http://localhost:3000

# Groq API for LLM Features
GROQ_API_KEY=gsk_your_groq_api_key

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Python ML Backend URL
PYTHON_BACKEND_URL=http://localhost:8000

# Cloudinary for Document Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Email Notifications
EMAIL_USER=
EMAIL_PASS=

# Admin User Email
ADMIN_EMAIL=admin@underwriteai.com
